{
  "name": "@davicotico/menu-editor",
  "version": "1.2.0",
  "description": "Vanilla Javascript Menu Editor Library (made with Typescript)",
  "main": "./lib/index.js",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "require": "./lib/index.umd.js"
    },
    "./lib/css/*": {
      "import": "./lib/css/*",
      "require": "./lib/css/*"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davicotico/menu-editor.git"
  },
  "keywords": [
    "menu-editor",
    "javascript-menu-editor",
    "typescript-menu-editor",
    "sortable",
    "draggable",
    "menu"
  ],
  "author": {
    "name": "David Tomas Ticona Saravia",
    "url": "https://davidticona.com"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/davicotico/menu-editor/issues"
  },
  "homepage": "https://davidticona.com/demos/javascript-menu-editor/",
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/sortablejs": "^1.15.9",
    "@typescript/typescript6": "^6.0.2",
    "bootstrap": "^5.3.8",
    "sass": "^1.101.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3"
  },
  "dependencies": {
    "sortablejs": "^1.15.7"
  }
}